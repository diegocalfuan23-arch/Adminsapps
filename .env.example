# Base propia del panel (usuarios del panel, notas, datos consolidados).
DATABASE_URL=""

# Bases de los productos monitoreados. Solo lectura: el panel nunca escribe
# en ellas. Copiar desde el .env de cada proyecto.
DATABASE_URL_FACILAGUA=""
DATABASE_URL_MECANICOAPP=""

# Facilapr: para crear comités desde el panel. El panel no escribe en la base de
# Facilapr: le pide a Facilapr que cree la cuenta por su endpoint interno.
# FACILAPR_API_SECRET debe ser IGUAL a SUPERADMIN_API_SECRET en Facilapr (mín. 24
# caracteres). Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FACILAPR_URL="https://facilapr.cl"
FACILAPR_API_SECRET=""

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Solo este correo puede crear cuenta, y solo con REGISTRO_ABIERTO="si".
CORREO_AUTORIZADO=""

# Enciéndelo una vez para crear tu cuenta, luego quítalo o déjalo en "no".
# Con el registro cerrado el endpoint deja de existir, no solo de aceptar.
REGISTRO_ABIERTO="no"
